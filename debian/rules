#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build

# The kiosk variant: the single-window browser odio's UI runs in. Upstream's
# own packaging script names the two variants the other way round.
override_dh_auto_configure:
	dh_auto_configure -- -DFULLBROWSER=OFF

# Upstream's CMakeLists has no install() rule, so dh_auto_install would stage
# nothing; the binary is renamed on the way, which a .install file cannot do.
override_dh_auto_install:
	install -Dm755 build/FBrowser debian/fbrowser-kiosk/usr/bin/fbrowser-kiosk
